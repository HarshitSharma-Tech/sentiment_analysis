# ==============================================================================
# CROWDWISDOM SENTIMENT PRICE PREDICTION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: ALL CREDENTIALS BELOW ARE STRICTLY OPTIONAL!
# The entire pipeline runs 100% FREE without any API keys or subscriptions.
# Do NOT purchase any API plan or credit card-gated service.
# ==============================================================================

# Database Path (Default: local SQLite database in database/crowdwisdom.db)
DATABASE_PATH=database/crowdwisdom.db

# Target Asset
ASSET_TICKER=BTC-USD
DATA_FREQUENCY=1h   # Options: 1h (hourly) or 1d (daily)

# Apify Connector (OPTIONAL: Only needed if you have an Apify account / free token)
# If empty, the system uses free local CSV/JSON imports and reproducible datasets.
APIFY_API_TOKEN=

# Tavily Search API (OPTIONAL: If empty, free RSS news feeds are used)
TAVILY_API_KEY=

# Exa Search API (OPTIONAL: If empty, free RSS news feeds are used)
EXA_API_KEY=

# Logging level
LOG_LEVEL=INFO
